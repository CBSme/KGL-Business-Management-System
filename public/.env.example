# MongoDB connection string 
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster.mongodb.net/kgl-db

# JWT secret key - use a long random string
JWT_SECRET=your_very_long_random_secret_key_here

# Gmail credentials for password reset emails
GMAIL_USER=youremail@gmail.com
GMAIL_PASS=your_16_character_app_password

# Base URL of the app (change to the live URL when deploying)
APP_URL=http://localhost:3000
